# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site (Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Organizer billing (publish gate only — not for invited/RSVP flows)
NEXT_PUBLIC_FREE_ORGANIZED_EVENTS_ENABLED=true
FREE_ORGANIZED_EVENTS_LIMIT=1
NEXT_PUBLIC_FREE_ORGANIZED_EVENTS_LIMIT=1
EVENT_PRICE_EUR=1.99
NEXT_PUBLIC_EVENT_PRICE_EUR=1.99

# Stripe (server-only — use exact names below)
# In Vercel: set STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET for Production AND Preview.
# Preview deployments without these vars return stripe_not_configured on /api/stripe/checkout.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# After changing secrets on Vercel, redeploy so runtime env is picked up.
# Client debug banner on Paso 2 compartir uses VERCEL_GIT_COMMIT_SHA via next.config env.
